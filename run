#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for room-valve-control development.
#

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != "$PROJECT_ROOT" && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
PROJECT_ROOT=$(pwd)
readonly PROJECT_ROOT

readonly COMPONENT=room_valve_control

################################################################################
# Development Commands

function sync {
  #@ Create or update the virtualenv with the dev dependencies
  #@ Category: Development
  uv sync --extra dev
}

function test {
  #@ Run the test suite (arguments are passed to pytest)
  #@ Category: Development
  .venv/bin/python -m pytest "$@"
}

################################################################################
# Quality Commands

function lint {
  #@ Check linting and formatting with ruff
  #@ Category: Quality
  .venv/bin/ruff check .
  .venv/bin/ruff format --check .
}

function format {
  #@ Fix lint findings and reformat with ruff
  #@ Category: Quality
  .venv/bin/ruff check --fix .
  .venv/bin/ruff format .
}

function typecheck {
  #@ Type check with mypy (strict)
  #@ Category: Quality
  .venv/bin/mypy
}

################################################################################
# Release Commands

function archive {
  #@ Build the release zip of the component into dist/
  #@ Category: Release
  local archive="$PROJECT_ROOT/dist/$COMPONENT.zip"
  mkdir -p dist
  rm -f "$archive"
  zip -r "$archive" "custom_components/$COMPONENT" -x '*/__pycache__/*' '*.pyc'
  echo "Archive written to dist/$COMPONENT.zip"
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "room-valve-control - Development Commands"
  echo "========================================="
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
